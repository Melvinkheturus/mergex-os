{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "vercel-build": {
      "dependsOn": ["^vercel-build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build:worker": {
      "dependsOn": ["^build"],
      "outputs": [".open-next/**", ".worker/**", ".next/**", "!.next/cache/**"]
    },
    "deploy:worker": {
      "dependsOn": ["build:worker"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "start": {
      "dependsOn": ["build"]
    }
  }
}
